# Runtime
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/empresa_tickets

# Sessions and JWT (replace with independent strong secrets)
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace-with-another-strong-secret

# Frontend and CORS (comma-separated exact origins in FRONTEND_URLS)
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GOOGLE_WORKSPACE_DOMAINS=grf.com.ar
ALLOWED_EMAIL_DOMAINS=grf.com.ar

# IT secrets: 32 random bytes encoded as 64 hex chars or base64.
# Keep this stable; rotating it requires a dedicated secret-rotation procedure.
IT_SECRETS_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@grf.com.ar

# Optional integrations and operations
ANTHROPIC_API_KEY=
LOG_LEVEL=info
FINNEGANS_KB_DISABLED=false
FINNEGANS_KB_URL=https://bc.finneg.com
FINNEGANS_KB_TIMEOUT_MS=8000
