{
  // Colector de red de GRF. Copiar a C:\ProgramData\GRF\NetCollector\appsettings.json y completar.
  // Las claves NO van acá: cada sección nombra la variable de máquina que la tiene.

  "Api": {
    "BaseUrl": "https://sistema-tickets-back.onrender.com",
    "ClientSlug": "red-colector-srvdatos"
    // "SecretVariable": "GRF_RED_COLECTOR_SECRETO"  (la crea install.ps1)
  },

  // "Parallelism": 6,
  // "DeviceTimeoutSeconds": 45,

  "RouterOs": {
    "User": "grf-monitor",
    "PasswordVariable": "GRF_RED_MIKROTIK_CLAVE"
    // "Port": 8729
  },

  "Snmp": {
    "CommunityVariable": "GRF_RED_SNMP_COMMUNITY"
  },

  // Controlador UniFi clásico (autoalojado, puerto 8443) con un usuario local View Only.
  "UniFi": {
    "Url": "https://192.0.2.10:8443",
    "Site": "default",
    "UserVariable": "GRF_RED_UNIFI_USUARIO",
    "PasswordVariable": "GRF_RED_UNIFI_CLAVE",
    // Huella SHA-256 del certificado; si se omite, se anota la primera que se ve.
    "CertificateSha256": null,
    "EveryMinutes": 5,
    // Clientes Wi-Fi (red, banda, señal); nunca invitados ni las VLANs de Endpoints.ExcludeVlans.
    "ReadClients": true
  },

  // Equipos finales (PCs, impresoras, cámaras, clientes Wi-Fi) en su puerto de acceso.
  "Endpoints": {
    "Enabled": true,
    // VLANs cuyos equipos no se envían, por ejemplo la de invitados.
    "ExcludeVlans": [300],
    // Desde cuántos equipos en un mismo puerto se lo marca como compartido.
    "SharedPortThreshold": 3
  },

  // Role: router | core | access. Driver: routeros (API-SSL) | snmp (v2c/v1 de lectura).
  "Devices": [
    { "Ip": "192.0.2.1", "Driver": "routeros", "Role": "router", "CertificateSha256": null },
    { "Ip": "192.0.2.11", "Driver": "snmp", "Role": "core" },
    { "Ip": "192.0.2.3", "Driver": "routeros", "Role": "access" },
    { "Ip": "192.0.2.6", "Driver": "snmp", "Role": "access" }
  ]
}
